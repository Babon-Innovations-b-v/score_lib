{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score-lib-algorithm/1",
  "title": "definitions/algorithms/<name>.toml",
  "type": "object",
  "required": [
    "name",
    "title",
    "entry",
    "roots",
    "constants",
    "preset",
    "needs",
    "tests"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "title": {
      "type": "string"
    },
    "entry": {
      "type": "string",
      "pattern": "^[\\w.]+:\\w+$"
    },
    "bake": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[\\w.]+:\\w+$"
      }
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "search": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[\\w/.]+\\.py:\\w+$"
      }
    },
    "record_fields": {
      "type": "string",
      "pattern": "^[\\w/.]+:\\d+-\\d+$"
    },
    "preset": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "type": "string"
    },
    "contract": {
      "type": "array"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "picture": {
      "type": "array",
      "maxItems": 2
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outside": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "where",
          "why",
          "paths"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
