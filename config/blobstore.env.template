# The blob store score-lib puts and gets entry files from. Set ONE of the two blocks.
# Values here are placeholders only; real values live in your environment or secret manager, never in this repo.

# Local folder backend
SCORE_LIB_BLOBS_DIR=<folder holding blobs/<sha[:2]>/<sha>>

# S3-compatible backend (any provider that speaks the S3 API)
SCORE_LIB_S3_ENDPOINT=<https endpoint of the S3-compatible service>
SCORE_LIB_S3_BUCKET=<bucket name>
SCORE_LIB_S3_PREFIX=<optional key prefix>
SCORE_LIB_S3_REGION=<optional region>
AWS_ACCESS_KEY_ID=<access key>
AWS_SECRET_ACCESS_KEY=<secret key>
SCORE_LIB_PUBLIC_URL=<optional public read URL of the bucket and prefix>

# The export reads (read only)
SCORE_STORE=<a SCORE store's objects folder>
SCORE_REPO=<the score repository>
SCORE_LIB_CACHE=<optional folder for preview pictures, outside the repo>
