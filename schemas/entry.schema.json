{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score-lib-entry/1",
  "title": "score_lib entry",
  "type": "object",
  "required": [
    "schema",
    "address",
    "kind",
    "id",
    "version",
    "title",
    "state",
    "picture",
    "files",
    "usd",
    "requires",
    "provenance",
    "tags",
    "seen_in"
  ],
  "properties": {
    "schema": {
      "const": "score-lib-entry/1"
    },
    "address": {
      "type": "string",
      "pattern": "^(algorithm|surface|model|light|sound|effect|character|ground|kit|layer|place)/[a-z0-9_]+(\\.[a-z0-9_]+)?@[1-9][0-9]*$"
    },
    "kind": {
      "enum": [
        "algorithm",
        "surface",
        "model",
        "light",
        "sound",
        "effect",
        "character",
        "ground",
        "kit",
        "layer",
        "place"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)?$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "draft",
        "locked",
        "withdrawn"
      ]
    },
    "locked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "picture": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "file",
            "made_by",
            "of"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "made_by": {
              "type": "string"
            },
            "of": {
              "type": "string"
            }
          }
        }
      ]
    },
    "picture_reason": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "usd",
              "record",
              "picture",
              "texture",
              "audio",
              "gltf",
              "code",
              "web3d"
            ]
          }
        }
      }
    },
    "usd": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "root",
            "use",
            "path"
          ],
          "properties": {
            "root": {
              "type": "string"
            },
            "use": {
              "enum": [
                "reference",
                "payload",
                "sublayer",
                "open"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^score_lib/"
            },
            "layer": {
              "type": [
                "string",
                "null"
              ]
            },
            "default_prim": {
              "type": [
                "string",
                "null"
              ]
            },
            "up_axis": {
              "type": [
                "string",
                "null"
              ]
            },
            "meters_per_unit": {
              "type": [
                "number",
                "null"
              ]
            },
            "time_codes_per_second": {
              "type": [
                "number",
                "null"
              ]
            },
            "neighbours": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(algorithm|surface|model|light|sound|effect|character|ground|kit|layer|place)/[a-z0-9_]+(\\.[a-z0-9_]+)?@[1-9][0-9]*$"
              }
            }
          }
        }
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(algorithm|surface|model|light|sound|effect|character|ground|kit|layer|place)/[a-z0-9_]+(\\.[a-z0-9_]+)?@[1-9][0-9]*$"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "world",
        "commit",
        "made_with"
      ],
      "properties": {
        "world": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "models": {
          "type": "array"
        },
        "files_from": {
          "type": "object"
        },
        "made_with": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "what",
              "by"
            ],
            "properties": {
              "what": {
                "type": "string"
              },
              "by": {
                "type": "string",
                "minLength": 1
              },
              "carried": {
                "const": true
              }
            },
            "additionalProperties": false
          }
        },
        "outside": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "version",
              "where",
              "why"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "where": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "tags": {
      "type": "object",
      "properties": {
        "style": {
          "type": "array",
          "items": {
            "enum": [
              "ink",
              "flat",
              "photo"
            ]
          }
        },
        "engine": {
          "type": "array",
          "items": {
            "enum": [
              "godot4",
              "usd"
            ]
          }
        },
        "place_kind": {
          "type": "array",
          "items": {
            "enum": [
              "inside",
              "outside",
              "moon",
              "mars",
              "earth",
              "ship"
            ]
          }
        }
      },
      "additionalProperties": {
        "type": "array"
      }
    },
    "seen_in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "web3d": {
      "type": "object",
      "required": [
        "file",
        "light",
        "full_sha256",
        "light_sha256",
        "source"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "light": {
          "type": "string"
        },
        "full_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "light_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "from": {
          "type": "object"
        },
        "finishes": {
          "type": "object"
        },
        "replaced": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "picture": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "picture_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "locked",
              "withdrawn"
            ]
          }
        }
      },
      "then": {
        "required": [
          "locked"
        ]
      }
    }
  ],
  "not": {
    "required": [
      "licence"
    ]
  }
}
